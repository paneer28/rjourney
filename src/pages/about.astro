---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import IntroBand from '../components/IntroBand.astro';
import Band from '../components/Band.astro';
import Panel from '../components/Panel.astro';
import PersonCard from '../components/PersonCard.astro';
import { leadership, board } from '../data/team';
import { site } from '../data/site';

const beliefs = [
  {
    heading: 'Start with what a child loves.',
    text: 'An interest in flowers, computers, or sport is the best place to begin teaching a skill.',
    color: 'yellow',
  },
  {
    heading: 'Belonging comes from doing things together.',
    text: 'Children get to know each other by working side by side, so every activity is something to do, not something to watch.',
    color: 'orange',
  },
  {
    heading: 'Families are part of it.',
    text: 'When a child has somewhere to go and something to look forward to, the whole family benefits.',
    color: 'white',
  },
] as const;
---

<BaseLayout
  title="About"
  description="R Journey is a nonprofit in Apex, North Carolina, started in 2025. We run activities that build independence and inclusion for children, teens, and young adults with Autism Spectrum Disorder (ASD)."
>
  <PageHeading heading="About R Journey" />

  <IntroBand id="mission" heading="Why we exist">
    <p>
      R Journey exists to improve the lives of children, teens, and young adults with Autism Spectrum Disorder (ASD), and
      the lives of their families.
    </p>
    <p>
      We do it through activities that build independence and inclusion. For neurodivergent young people, that can mean
      learning a skill, joining a team, or making something with their own hands.
    </p>
  </IntroBand>

  <Band color="pink" labelledby="vision-heading">
    <div class="flow">
      <h2 id="vision-heading">What we're working toward</h2>
      <p class="lead">
        We want the Triangle to be a place where young people with ASD are welcomed and given real chances to grow, and
        where the families of neurodivergent children have people to lean on.
      </p>
    </div>
  </Band>

  <Band labelledby="beliefs-heading">
    <h2 id="beliefs-heading" class="heading-center">What we believe</h2>
    <div class="card-row">
      {
        beliefs.map((belief) => (
          <Panel heading={belief.heading} color={belief.color} headingLevel="h3">
            <p>{belief.text}</p>
          </Panel>
        ))
      }
    </div>
  </Band>

  <Band labelledby="story-heading" class="story-band">
    <div class="flow">
      <h2 id="story-heading">Where we are now</h2>
      <p>
        R Journey began in Apex in 2025. We are new and we are building carefully: a few activities, run well, with
        partners who share our goals.
      </p>
      <p>{site.statusLine}</p>
    </div>
  </Band>

  <Band color="white" labelledby="leadership-heading">
    <h2 id="leadership-heading" class="heading-center">Leadership team</h2>
    <ul class="card-row" role="list">
      {
        leadership.map((person) => (
          <li>
            <PersonCard person={person} />
          </li>
        ))
      }
    </ul>
  </Band>

  <Band color="white" labelledby="board-heading" class="board-band">
    <h2 id="board-heading" class="heading-center">Board of directors</h2>
    <ul class="card-row board" role="list">
      {
        board.map((person) => (
          <li>
            <PersonCard person={person} size="small" />
          </li>
        ))
      }
    </ul>
  </Band>
</BaseLayout>

<style>
  .lead {
    font-size: 1.2em;
  }

  /* "Where we are now" follows the beliefs on the same paper color; close the gap a little. */
  :global(.story-band) {
    padding-top: 0;
  }

  /* Leadership and board share the white band; no double padding between them. */
  :global(.board-band) {
    padding-top: 0;
  }

  /* Board cards are smaller: a narrower row. */
  .board {
    max-width: 48rem;
    margin-inline: auto;
  }

  /* People cards on a white band need an edge to stand apart. */
  .card-row :global(.person) {
    background: var(--paper);
    height: 100%;
  }

  :global(html[data-mode='calm']) .card-row {
    max-width: 32rem;
    margin-inline: auto;
  }

  :global(html[data-mode='calm']) .board {
    max-width: 20rem;
  }
</style>
