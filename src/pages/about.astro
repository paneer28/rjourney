---
// About: who R Journey is, why it exists, what it believes, where it is now,
// and the people behind it.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import StoryBlock from '../components/StoryBlock.astro';
import Band from '../components/Band.astro';
import Flower from '../components/Flower.astro';
import PersonCard from '../components/PersonCard.astro';
import NextCards from '../components/NextCards.astro';
import { leadership, board } from '../data/team';
import { photos } from '../data/images';
import { programs } from '../data/programs';
import { site } from '../data/site';

const running = programs.filter((program) => program.status === 'now');
const planned = programs.filter((program) => program.status === 'planned');

const facts = [
  { figure: String(site.founded), text: 'Founded in Apex, North Carolina', color: 'white' },
  { figure: site.impact.sessions, text: 'Sessions held across our programs', color: 'orange' },
  { figure: site.impact.participants, text: 'Times kids and teens have joined a program', color: 'yellow' },
  { figure: '501(c)(3)', text: 'Tax-exempt nonprofit', color: 'pink' },
] as const;

const beliefs = [
  {
    heading: 'Start with what a child loves.',
    text: 'An interest in flowers, computers, or sport is the best place to begin teaching a skill. A child who cares about the thing in front of them will stay with it when it gets hard.',
    color: 'yellow',
  },
  {
    heading: 'Belonging comes from doing things together.',
    text: 'Children get to know each other by working side by side, so every program is something to do, not something to watch.',
    color: 'orange',
  },
  {
    heading: 'Families are part of it.',
    text: 'When a child has somewhere to go and something to look forward to, the whole family benefits. Parents get to see their child do something new. Brothers and sisters get to cheer.',
    color: 'white',
  },
] as const;

const partners = [
  { name: 'Rookie Rackets', text: 'A fellow nonprofit. Their volunteers coach Badminton Camp with ours.' },
  { name: 'Peak Sports, Morrisville', text: 'Donates the court time for Badminton Camp, and will host the Violin Program.' },
  { name: 'STEM Leaders', text: 'Their coaches will teach STEM Builders Camp.' },
];

const personColors = ['yellow', 'orange', 'pink'] as const;

// One card per person. Someone on both the leadership team and the board
// (matched by name, ignoring a credential like ", MD") gets one card with both roles.
const baseName = (name: string) => name.split(',')[0].trim();
const roster = leadership.map((person) => ({ person, roles: ['Leadership team'] }));
for (const member of board) {
  const match = roster.find((entry) => baseName(entry.person.name) === baseName(member.name));
  if (match) match.roles.push('Board of directors');
  else roster.push({ person: member, roles: ['Board of directors'] });
}
---

<BaseLayout
  title="About"
  description="R Journey is a nonprofit in Apex, North Carolina, started in 2025. We run programs that build independence and inclusion for children, teens, and young adults with Autism Spectrum Disorder (ASD)."
>
  <PageHero heading="About R Journey" kicker="Who we are" images={[photos.group, photos.celosia]}>
    <p>A young nonprofit in Apex, North Carolina, started in {site.founded}.</p>
    <p>
      We run hands-on programs where children and teens with Autism Spectrum Disorder (ASD) build a skill, meet people,
      and have a good time doing it.
    </p>
  </PageHero>

  <!-- At a glance -->
  <section class="facts" aria-label="R Journey at a glance">
    <div class="container">
      <ul class="facts__list" role="list">
        {
          facts.map((fact) => (
            <li class={`fact fact--${fact.color}`}>
              <span class="fact__figure">{fact.figure}</span>
              <span class="fact__text">{fact.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Why we exist -->
  <Band labelledby="mission-heading" class="mission-band">
    <StoryBlock id="mission" heading="Why we exist" image={photos.coachBalloon} color="orange">
      <p>
        R Journey exists to improve the lives of children, teens, and young adults with Autism Spectrum Disorder (ASD),
        and the lives of their families.
      </p>
      <p>
        We do it through programs that build independence and inclusion. For neurodivergent young people, that can mean
        learning a skill, joining a team, or making something with their own hands.
      </p>
    </StoryBlock>
  </Band>

  <!-- What we're working toward -->
  <section class="vision" aria-labelledby="vision-heading">
    <div class="vision__blocks" aria-hidden="true">
      <span class="vblock vblock--yellow"></span>
      <span class="vblock vblock--black"></span>
    </div>
    <div class="container vision__inner">
      <h2 id="vision-heading" class="vision__label">What we're working toward</h2>
      <p class="vision__statement">
        We want the Triangle to be a place where young people with ASD are welcomed and given real chances to grow, and
        where their families have people to lean on.
      </p>
      <Flower petals="yellow" center="orange" size="4.5rem" rotate={-12} style="top: -1rem; right: 4%" />
      <Flower petals="white" center="pink" size="2.75rem" rotate={16} style="bottom: -0.5rem; right: 24%" />
    </div>
  </section>

  <!-- What we believe -->
  <Band labelledby="beliefs-heading">
    <h2 id="beliefs-heading" class="heading-center">What we believe</h2>
    <ol class="beliefs" role="list">
      {
        beliefs.map((belief, i) => (
          <li class={`belief belief--${belief.color}`}>
            <span class="belief__number" aria-hidden="true">{i + 1}</span>
            <h3 class="belief__heading">{belief.heading}</h3>
            <p>{belief.text}</p>
          </li>
        ))
      }
    </ol>
  </Band>

  <!-- Where we are now -->
  <Band color="yellow" labelledby="now-heading">
    <div class="now">
      <div class="now__text flow">
        <h2 id="now-heading">Where we are now</h2>
        <p>
          R Journey began in Apex in {site.founded}. Since then we've held {site.impact.sessions} sessions, and kids and
          teens have joined our programs more than {site.impact.participants.replace('+', '')} times. We're still new, and
          we're building carefully: a few programs, run well, with partners who share our goals.
        </p>
        <p>
          We'd rather run one program that families can count on than five that come and go. When a program is working,
          we keep it. When we've learned enough, we start the next one.
        </p>
        <p class="small">{site.statusLine}</p>
      </div>

      <div class="now__lists">
        <div class="now__card">
          <h3 class="now__heading">Running now</h3>
          <ul class="chips" role="list">
            {running.map((program) => (
              <li><a class="chip chip--now" href={`/programs#${program.id}`}>{program.name}</a></li>
            ))}
          </ul>
          <h3 class="now__heading">Coming soon</h3>
          <ul class="chips" role="list">
            {planned.map((program) => (
              <li><a class="chip" href={`/programs#${program.id}`}>{program.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="now__card now__card--partners">
          <h3 class="now__heading">Working with</h3>
          <ul class="partners" role="list">
            {partners.map((partner) => (
              <li>
                <strong>{partner.name}.</strong> {partner.text}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Band>

  <!-- People -->
  <Band color="white" labelledby="people-heading">
    <div class="people-head flow">
      <h2 id="people-heading" class="heading-center">The people behind R Journey</h2>
    </div>

    <ul class="roster" role="list" style={`--roster-count: ${Math.min(roster.length, 4)}`}>
      {
        roster.map((entry, i) => (
          <li>
            <PersonCard person={entry.person} role={entry.roles.join(' · ')} color={personColors[i % personColors.length]} />
          </li>
        ))
      }
    </ul>
  </Band>

  <NextCards
    id="next"
    heading="Come and see for yourself"
    items={[
      {
        title: 'Our programs',
        text: "What we've run, what's running now, and what's coming soon.",
        label: 'See our programs',
        href: '/programs',
        color: 'yellow',
        image: photos.coding,
      },
      {
        title: 'Sign up',
        text: "Tell us a little about your child. We'll tell you what's running and help you choose.",
        label: 'Sign up for a program',
        form: 'signup',
        color: 'orange',
      },
      {
        title: 'Help us grow',
        text: 'Every gift goes toward programs for children and teens with ASD.',
        label: 'Donate',
        href: '/donate',
        color: 'pink',
      },
    ]}
  />
</BaseLayout>

<style>
  /* ---------- At a glance: four tiles pulled up over the hero's bottom edge ---------- */
  .facts {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * var(--space-8));
  }

  @media (max-width: 55.99rem) {
    .facts {
      margin-top: var(--space-6);
    }
  }

  .facts__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    color: var(--ink);
    border: 2px solid var(--ink);
  }

  .fact--white { background: var(--white); }
  .fact--orange { background: var(--orange); }
  .fact--yellow { background: var(--yellow); }
  .fact--pink { background: var(--pink); }

  .fact__figure {
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    font-size: clamp(1.75rem, 4vw, 3.25rem);
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 39.99rem) {
    .fact {
      padding: var(--space-4);
    }
  }

  .fact--pink .fact__figure {
    color: var(--on-pink-heading);
  }

  .fact__text {
    font-weight: 700;
    line-height: 1.3;
  }

  @media (min-width: 56rem) {
    :global(html:not([data-mode='calm'])) .facts__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      box-shadow: calc(-1 * var(--shadow-offset) * 1.5) calc(var(--shadow-offset) * 1.5) 0 var(--black);
    }

    :global(html:not([data-mode='calm'])) .fact + .fact {
      border-left: 0;
    }

    :global(html:not([data-mode='calm'])) .fact {
      padding: var(--space-6);
    }
  }

  :global(html[data-mode='calm']) .facts {
    margin-top: var(--space-7);
  }

  /* ---------- Why we exist ---------- */
  :global(.mission-band) {
    --band-space-top: var(--section-space);
  }

  /* ---------- What we're working toward: a big statement on pink ---------- */
  .vision {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--section-space);
    background: var(--pink);
    color: var(--ink);
  }

  .vision__blocks {
    display: var(--decoration);
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .vblock {
    position: absolute;
  }

  .vblock--yellow {
    right: 0;
    bottom: 0;
    width: 20%;
    height: 46%;
    background: var(--yellow);
  }

  .vblock--black {
    top: 0;
    right: 24%;
    width: 7%;
    height: 24%;
    background: var(--black);
  }

  @media (max-width: 55.99rem) {
    .vision__blocks {
      display: none;
    }
  }

  .vision__inner {
    position: relative;
  }

  .vision__label {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--black);
    color: var(--on-black);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .vision__statement {
    max-width: 22ch;
    margin-top: var(--space-6);
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    text-transform: var(--heading-transform);
    font-size: clamp(2.25rem, 5.5vw, 4.75rem);
    line-height: 1.02;
    color: var(--ink);
  }

  /* ---------- What we believe ---------- */
  .beliefs {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }

  .belief {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-7) var(--space-6) var(--space-6);
    color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: calc(-1 * var(--shadow-offset)) var(--shadow-offset) 0 var(--black);
  }

  .belief--yellow { background: var(--yellow); }
  .belief--orange { background: var(--orange); }
  .belief--white { background: var(--white); }

  .belief__number {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    background: var(--black);
    color: var(--on-black);
    font-family: var(--heading-font);
    font-size: 2rem;
    line-height: 1;
    box-shadow: calc(-1 * var(--shadow-offset)) var(--shadow-offset) 0 var(--pink);
  }

  .belief__heading {
    font-size: var(--fs-card);
  }

  @media (min-width: 56rem) {
    :global(html:not([data-mode='calm'])) .beliefs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }

    :global(html:not([data-mode='calm'])) .belief:nth-child(2) {
      margin-top: calc(var(--stagger) / 2);
    }

    :global(html:not([data-mode='calm'])) .belief:nth-child(3) {
      margin-top: var(--stagger);
    }
  }

  /* ---------- Where we are now ---------- */
  .now {
    display: grid;
    gap: var(--space-7);
  }

  .now__lists {
    display: grid;
    gap: var(--space-5);
  }

  .now__card {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--white);
    border: 2px solid var(--ink);
    box-shadow: calc(-1 * var(--shadow-offset)) var(--shadow-offset) 0 var(--black);
  }

  .now__card--partners {
    background: var(--paper);
  }

  .now__heading {
    font-size: calc(var(--fs-card) * 0.85);
  }

  .now__heading:not(:first-child) {
    margin-top: var(--space-3);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--paper);
    border: 2px solid var(--ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--dur) var(--ease);
  }

  .chip--now {
    background: var(--yellow);
  }

  .chip:hover,
  .chip:focus-visible {
    text-decoration-color: currentColor;
  }

  .partners {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .partners li {
    padding-left: var(--space-4);
    border-left: 4px solid var(--orange);
    line-height: 1.45;
  }

  @media (min-width: 56rem) {
    :global(html:not([data-mode='calm'])) .now {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  /* ---------- People: one row of cards ---------- */
  .roster {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }

  .roster :global(.person__mono) {
    aspect-ratio: 4 / 3;
  }

  .roster :global(.person__initials) {
    font-size: clamp(3rem, 6vw, 5rem);
  }

  .roster :global(.person__name) {
    font-size: calc(var(--fs-card) * 0.8);
  }

  @media (min-width: 56rem) {
    .roster {
      grid-template-columns: repeat(var(--roster-count, 4), minmax(0, 1fr));
    }
  }

  :global(html[data-mode='calm']) .roster {
    max-width: 32rem;
    grid-template-columns: 1fr;
  }

  :global(html[data-mode='calm']) .belief,
  :global(html[data-mode='calm']) .now__card {
    box-shadow: none;
  }
</style>
