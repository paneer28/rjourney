---
// Corporate partnerships: how a local business can help, a partner already
// doing it, and what a business can expect from R Journey.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Band from '../../components/Band.astro';
import StoryBlock from '../../components/StoryBlock.astro';
import FormButton from '../../components/FormButton.astro';
import NextCards from '../../components/NextCards.astro';
import { photos } from '../../data/images';
import { site } from '../../data/site';

const ways = [
  {
    icon: 'gift',
    heading: 'Sponsor a program.',
    text: 'Cover the supplies for a program, or a season of sessions.',
    color: 'yellow',
  },
  {
    icon: 'space',
    heading: 'Share your space or equipment.',
    text: 'A court, a kitchen, a studio, a room with tables. Peak Sports in Morrisville donates the court time for our Badminton Camp.',
    color: 'orange',
  },
  {
    icon: 'door',
    heading: 'Open your doors.',
    text: 'Our Buddy Program, coming soon, will pair neurodivergent teens with a buddy to shadow and help out in real workplaces. Yours could be one of them.',
    color: 'pink',
  },
  {
    icon: 'team',
    heading: 'Volunteer as a team.',
    text: 'Bring your colleagues to help run a session.',
    color: 'white',
  },
] as const;

const promises = [
  {
    heading: 'The same people, start to finish',
    text: "We're a small organization. You'll deal with the same people from the first call onward.",
  },
  {
    heading: 'A plain account',
    text: "We'll tell you plainly how your support was used.",
  },
  {
    heading: 'A registered nonprofit',
    text: `${site.statusLine} Our EIN is ${site.ein}.`,
  },
];
---

<BaseLayout
  title="Corporate partnerships"
  description="A local business can do a lot for children with Autism Spectrum Disorder (ASD): sponsor a program, share space or equipment, open your doors, or volunteer as a team."
>
  <PageHero heading="Corporate partnerships" kicker="Get involved" color="white" images={[photos.badmintonWarmup, photos.bouquets]}>
    <p>A local business can do a lot for children with Autism Spectrum Disorder (ASD).</p>
    <p>Here are four ways to help, and what you can expect from us in return.</p>
    <FormButton slot="actions" form="partner">Get in touch</FormButton>
  </PageHero>

  <!-- Ways to help -->
  <Band labelledby="ways-heading">
    <h2 id="ways-heading" class="heading-center">Ways to help</h2>
    <ul class="ways" role="list">
      {
        ways.map((way) => (
          <li class={`way way--${way.color}`}>
            <span class="way__icon" aria-hidden="true">
              {way.icon === 'gift' && (
                <svg viewBox="0 0 32 32" focusable="false"><path d="M4 12h24v6H4z M6 18h20v11H6z M16 12v17 M16 12c-3-6-9-6-9-2s6 2 9 2c3 0 9 2 9-2s-6-4-9 2" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" /></svg>
              )}
              {way.icon === 'space' && (
                <svg viewBox="0 0 32 32" focusable="false"><path d="M3 6h26v20H3z M16 6v20 M3 16h26" fill="none" stroke="currentColor" stroke-width="2.5" /></svg>
              )}
              {way.icon === 'door' && (
                <svg viewBox="0 0 32 32" focusable="false"><path d="M7 3h18v26H7z M7 3l12 4v22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" /><circle cx="16" cy="17" r="1.5" fill="currentColor" /></svg>
              )}
              {way.icon === 'team' && (
                <svg viewBox="0 0 32 32" focusable="false"><circle cx="10" cy="11" r="4" fill="none" stroke="currentColor" stroke-width="2.5" /><circle cx="22" cy="11" r="4" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="M3 27c0-5 3-8 7-8s7 3 7 8 M15 27c0-5 3-8 7-8s7 3 7 8" fill="none" stroke="currentColor" stroke-width="2.5" /></svg>
              )}
            </span>
            <h3 class="way__heading">{way.heading}</h3>
            <p>{way.text}</p>
          </li>
        ))
      }
    </ul>
  </Band>

  <!-- A partner already doing it -->
  <Band color="white" labelledby="spotlight-heading">
    <p class="spotlight-kicker">Already doing it</p>
    <StoryBlock id="spotlight" heading="Peak Sports, Morrisville" image={photos.badmintonCourt} color="yellow">
      <p>
        Peak Sports donates the court time for our Badminton Camp. Every session, children with ASD learn the game on
        courts they've given us, coached by volunteers from R Journey and Rookie Rackets.
      </p>
      <p>They'll also host our Violin Program when it starts.</p>
      <p class="spotlight-ask"><strong>Have a space that sits empty some afternoons?</strong> That's how it starts.</p>
    </StoryBlock>
  </Band>

  <!-- What you can expect -->
  <section class="expect" aria-labelledby="expect-heading">
    <div class="container">
      <h2 id="expect-heading" class="heading-center">What you can expect from us</h2>
      <ul class="promises" role="list">
        {
          promises.map((promise, i) => (
            <li class="promise">
              <span class="promise__check" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M4 12.5l5 5L20 6.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" /></svg>
              </span>
              <h3 class="promise__heading">{promise.heading}</h3>
              <p>{promise.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Let's talk -->
  <section class="talk" aria-labelledby="talk-heading">
    <div class="talk__blocks" aria-hidden="true">
      <span class="kblock kblock--yellow"></span>
      <span class="kblock kblock--orange"></span>
    </div>
    <div class="container talk__inner">
      <div class="talk__panel flow">
        <h2 id="talk-heading">Let's talk about what would suit your business</h2>
        <p>Tell us a little about your business and what you have in mind. Then we'll work out the details together.</p>
        <div class="talk__actions">
          <FormButton form="partner" variant="yellow">Get in touch</FormButton>
          <a class="talk__email" href={`mailto:${site.email}`}>Or email {site.email}</a>
        </div>
      </div>
    </div>
  </section>

  <NextCards
    id="next"
    heading="Other ways to get involved"
    items={[
      {
        title: 'Partner on a program',
        text: 'For nonprofits, clubs, schools, and studios that teach something children enjoy.',
        label: 'Run a program with us',
        href: '/get-involved/partner-on-a-program',
        color: 'yellow',
      },
      {
        title: 'Give',
        text: 'Every gift goes toward programs for children and teens with ASD.',
        label: 'Donate',
        href: '/donate',
        color: 'pink',
        image: photos.bouquets,
      },
    ]}
  />
</BaseLayout>

<style>
  /* ---------- Ways to help ---------- */
  .ways {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }

  .way {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-7) var(--space-6) var(--space-6);
    color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: calc(-1 * var(--shadow-offset)) var(--shadow-offset) 0 var(--black);
  }

  .way--yellow { background: var(--yellow); }
  .way--orange { background: var(--orange); }
  .way--pink { background: var(--pink); }
  .way--white { background: var(--white); }

  .way__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    background: var(--black);
    color: var(--on-black);
  }

  .way__icon svg {
    width: 2rem;
    height: 2rem;
  }

  .way__heading {
    font-size: var(--fs-card);
  }

  .way--pink .way__heading {
    color: var(--on-pink-heading);
  }

  @media (min-width: 56rem) {
    :global(html:not([data-mode='calm'])) .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    :global(html:not([data-mode='calm'])) .way:nth-child(even) {
      transform: translateY(calc(var(--stagger) / 2));
    }
  }

  /* ---------- Spotlight ---------- */
  .spotlight-kicker {
    display: inline-block;
    margin-bottom: var(--space-5);
    padding: var(--space-1) var(--space-3);
    background: var(--black);
    color: var(--on-black);
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .spotlight-ask {
    padding-top: var(--space-4);
    border-top: 2px solid var(--ink);
  }

  /* ---------- What you can expect ---------- */
  .expect {
    padding-block: var(--section-space);
    background: var(--yellow);
    color: var(--ink);
  }

  .promises {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }

  .promise {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-5);
    border-top: 3px solid var(--ink);
  }

  .promise__check {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: var(--black);
    color: var(--yellow);
  }

  .promise__check svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .promise__heading {
    font-size: var(--fs-card);
  }

  @media (min-width: 56rem) {
    :global(html:not([data-mode='calm'])) .promises {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-7);
    }
  }

  :global(html[data-mode='calm']) .promise {
    border-top-color: var(--ink);
  }

  /* ---------- Let's talk ---------- */
  .talk {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--section-space);
  }

  .talk__blocks {
    display: var(--decoration);
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .kblock {
    position: absolute;
  }

  .kblock--yellow {
    left: 0;
    bottom: 0;
    width: 40%;
    height: 60%;
    background: var(--yellow);
  }

  .kblock--orange {
    right: 0;
    top: 0;
    width: 34%;
    height: 55%;
    background: var(--orange);
  }

  .talk__panel {
    width: min(100%, 44rem);
    margin-inline: auto;
    padding: var(--space-8) var(--space-7);
    background: var(--pink);
    color: var(--ink);
    --focus-color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: calc(-1 * var(--shadow-offset) * 1.5) calc(var(--shadow-offset) * 1.5) 0 var(--black);
  }

  .talk__panel h2 {
    color: var(--on-pink-heading);
    font-size: var(--fs-section);
  }

  .talk__panel p {
    font-size: 1.15em;
  }

  .talk__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding-top: var(--space-3);
  }

  .talk__email {
    font-weight: 700;
    font-size: var(--fs-small);
  }

  @media (max-width: 55.99rem) {
    .talk__panel {
      padding: var(--space-7) var(--space-5);
    }
  }

  :global(html[data-mode='calm']) .way,
  :global(html[data-mode='calm']) .talk__panel {
    box-shadow: none;
  }
</style>
