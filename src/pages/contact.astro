---
// Contact: every way to reach R Journey, the four forms, and what happens next.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Band from '../components/Band.astro';
import FormButton from '../components/FormButton.astro';
import { site, type FormName } from '../data/site';
import Flower from '../components/Flower.astro';

// The contact tiles. `href` makes the tile a link; the mail tile appears only
// when a mailing address is set in site.ts.
const details = [
  { icon: 'camera', label: 'Instagram', value: `@${site.instagram.handle}`, href: site.instagram.url, color: 'orange' },
  ...(site.mailingAddress ? [{ icon: 'pin', label: 'Mail', value: site.mailingAddress, color: 'white' }] : []),
  { icon: 'pin', label: 'Where we are', value: 'Apex, North Carolina. Serving families across the Triangle.', color: 'pink' },
] as { icon: string; label: string; value: string; href?: string; color: string }[];

const forms: { form: FormName; heading: string; text: string; button: string; color: string }[] = [
  {
    form: 'signup',
    heading: 'Sign up for a program',
    text: "Tell us about your child and which program interests you. We'll let you know when the next session is and what to bring.",
    button: 'Sign up',
    color: 'orange',
  },
  {
    form: 'question',
    heading: 'Ask a question',
    text: "Anything else on your mind? Send us a question and we'll get back to you.",
    button: 'Ask a question',
    color: 'yellow',
  },
  {
    form: 'volunteer',
    heading: 'Volunteer',
    text: 'Give some time to a program. Tell us a little about yourself and what you’d like to help with.',
    button: 'Volunteer with us',
    color: 'white',
  },
  {
    form: 'partner',
    heading: 'Partner with us',
    text: 'A business, nonprofit, school, or instructor with an idea for a program? Tell us about it.',
    button: 'Share your idea',
    color: 'pink',
  },
];

const steps = [
  { heading: 'You tell us a little', text: 'About your child, or about yourself, and what you’re interested in. A few lines is plenty.' },
  { heading: 'We get back to you', text: 'Someone from R Journey reads every message and replies, by phone, text, or email.' },
  { heading: 'We help you choose', text: 'We’ll tell you what’s running now, when the next session is, and what to bring.' },
];
---

<BaseLayout
  title="Contact"
  description="Sign up for an R Journey program or ask us a question online, or call or text (858) 610-9661. Based in Apex, North Carolina, serving families across the Triangle."
>
  <PageHero heading="Talk to us" kicker="Get in touch" color="orange">
    <p>Call, text, email, or fill in a form: whichever is easiest for you.</p>
    <p>
      Tell us a little about your child, or about yourself, and what you're interested in. We'll take it from there.
    </p>
    <div slot="aside" class="note">
      <p class="note__label">Call or text</p>
      <a class="note__number" href={site.phone.tel}>{site.phone.display}</a>
      <a class="note__sms" href={site.phone.sms}>Or send a text</a>
      <p class="note__label note__label--second">Email</p>
      <a class="note__email" href={`mailto:${site.email}`}>{site.email}</a>
      <Flower petals="yellow" center="pink" size="3.5rem" rotate={-12} style="top: -1.75rem; right: -1.25rem" />
    </div>
  </PageHero>

  <!-- Ways to reach us -->
  <Band labelledby="reach-heading">
    <h2 id="reach-heading" class="heading-center">Where to find us</h2>
    <ul class="details" role="list" style={`--detail-count: ${details.length}`}>
      {
        details.map((detail) => {
          const Tag = detail.href ? 'a' : 'div';
          return (
            <li class={`detail detail--${detail.color}`}>
              <Tag class="detail__inner" href={detail.href}>
                <span class="detail__icon" aria-hidden="true">
                  {detail.icon === 'phone' && (
                    <svg viewBox="0 0 32 32" focusable="false"><path d="M10 3h12v26H10z M14 25h4" fill="none" stroke="currentColor" stroke-width="2.5" /></svg>
                  )}
                  {detail.icon === 'mail' && (
                    <svg viewBox="0 0 32 32" focusable="false"><path d="M3 7h26v18H3z M3 7l13 10 13-10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" /></svg>
                  )}
                  {detail.icon === 'camera' && (
                    <svg viewBox="0 0 32 32" focusable="false"><path d="M4 4h24v24H4z" fill="none" stroke="currentColor" stroke-width="2.5" /><circle cx="16" cy="16" r="6" fill="none" stroke="currentColor" stroke-width="2.5" /><rect x="22" y="7" width="3" height="3" fill="currentColor" /></svg>
                  )}
                  {detail.icon === 'pin' && (
                    <svg viewBox="0 0 32 32" focusable="false"><path d="M16 29s-9-9.5-9-16a9 9 0 0 1 18 0c0 6.5-9 16-9 16z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" /><circle cx="16" cy="13" r="3.5" fill="currentColor" /></svg>
                  )}
                </span>
                <span class="detail__label">{detail.label}</span>
                <span class="detail__value">
                  {detail.value.includes('@') && !detail.value.startsWith('@')
                    ? detail.value.split('@').map((part, i) => (i === 0 ? <Fragment>{part}@<wbr /></Fragment> : part))
                    : detail.value}
                </span>
              </Tag>
            </li>
          );
        })
      }
    </ul>

    <p class="easier">
      <strong>If calling is hard for you,</strong> a form, text, or email is just as good. You can also{' '}
      <a href={site.phone.sms}>send us a text</a>.
    </p>
  </Band>

  <!-- The forms -->
  <Band color="white" labelledby="forms-heading">
    <div class="forms-head flow">
      <h2 id="forms-heading">Or use a form</h2>
      <p>Each one takes a few minutes. It opens right here on the page.</p>
    </div>
    <ul class="forms" role="list">
      {
        forms.map((item) => (
          <li class={`form-card form-card--${item.color}`} id={item.form === 'signup' ? 'sign-up' : item.form === 'question' ? 'ask' : undefined}>
            <h3 class="form-card__heading">{item.heading}</h3>
            <p>{item.text}</p>
            <FormButton form={item.form} variant={item.color === 'pink' ? 'yellow' : 'black'}>{item.button}</FormButton>
          </li>
        ))
      }
    </ul>
  </Band>

  <!-- What happens next -->
  <Band color="yellow" labelledby="after-heading">
    <h2 id="after-heading" class="heading-center">What happens after you get in touch</h2>
    <ol class="after" role="list">
      {
        steps.map((step, i) => (
          <li class="after__step">
            <span class="after__number" aria-hidden="true">{i + 1}</span>
            <h3 class="after__heading">{step.heading}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </Band>

</BaseLayout>

<style>
  /* ---------- The note in the header ---------- */
  .note {
    position: relative;
    display: grid;
    gap: var(--space-2);
    width: min(100%, 26rem);
    margin-inline: auto;
    padding: var(--space-7) var(--space-6);
    background: var(--white);
    color: var(--ink);
    border: 3px solid var(--ink);
    box-shadow: calc(-1 * var(--shadow-offset) * 1.5) calc(var(--shadow-offset) * 1.5) 0 var(--black);
  }

  .note__label {
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .note__label--second {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 2px dashed var(--ink);
  }

  .note__number {
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .note__number:hover,
  .note__number:focus-visible {
    text-decoration: underline;
  }

  .note__sms,
  .note__email {
    font-weight: 700;
  }

  .note__email {
    font-size: 1.2em;
    overflow-wrap: anywhere;
  }

  :global(html[data-mode='calm']) .note {
    box-shadow: none;
    margin-inline: 0;
  }

  /* ---------- Contact tiles ---------- */
  .details {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }



  .detail {
    color: var(--ink);
    --focus-color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: calc(-1 * var(--shadow-offset)) var(--shadow-offset) 0 var(--black);
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .detail--yellow { background: var(--yellow); }
  .detail--white { background: var(--white); }
  .detail--orange { background: var(--orange); }
  .detail--pink { background: var(--pink); }

  .detail:has(a:hover),
  .detail:has(a:focus-visible) {
    transform: translate(var(--button-lift), calc(-1 * var(--button-lift)));
    box-shadow: calc(-1 * (var(--shadow-offset) + 3px)) calc(var(--shadow-offset) + 3px) 0 var(--black);
  }

  .detail__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-6);
    color: inherit;
    text-decoration: none;
  }

  .detail__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: var(--space-4);
    background: var(--black);
    color: var(--on-black);
  }

  .detail__icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .detail__label {
    font-weight: 700;
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .detail__value {
    font-size: 1.3em;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  a.detail__inner .detail__value {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur) var(--ease);
  }

  a.detail__inner:hover .detail__value,
  a.detail__inner:focus-visible .detail__value {
    text-decoration-color: currentColor;
  }

  a.detail__inner:focus-visible {
    outline-offset: calc(-1 * var(--focus-width) - 2px);
  }

  .easier {
    max-width: none;
    margin-top: var(--space-7);
    padding: var(--space-5) var(--space-6);
    background: var(--white);
    border-left: 6px solid var(--pink);
    font-size: 1.1em;
  }

  .easier a {
    font-weight: 700;
  }

  /* ---------- The forms ---------- */
  .forms-head {
    max-width: 40rem;
  }

  .forms {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }

  .form-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-7) var(--space-6);
    color: var(--ink);
    --focus-color: var(--ink);
    border: 2px solid var(--ink);
  }

  .form-card--orange { background: var(--orange); }
  .form-card--yellow { background: var(--yellow); }
  .form-card--white { background: var(--paper); }
  .form-card--pink { background: var(--pink); }

  .form-card__heading {
    font-size: var(--fs-panel);
  }

  .form-card--pink .form-card__heading {
    color: var(--on-pink-heading);
  }

  .form-card :global(.button) {
    margin-top: auto;
  }

  @media (min-width: 56rem) {
    :global(html:not([data-mode='calm'])) .forms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- What happens next ---------- */
  .after {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .after__step {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-7) var(--space-6) var(--space-6);
    background: var(--white);
    border: 2px solid var(--ink);
  }

  .after__number {
    position: absolute;
    top: calc(-1 * var(--space-5));
    left: var(--space-6);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: var(--black);
    color: var(--on-black);
    font-family: var(--heading-font);
    font-size: 1.75rem;
    line-height: 1;
  }

  .after__heading {
    font-size: var(--fs-card);
  }

  @media (min-width: 56rem) {
    :global(html:not([data-mode='calm'])) .after {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  :global(html[data-mode='calm']) .after {
    gap: var(--space-8);
  }

  :global(html[data-mode='calm']) .detail {
    box-shadow: none;
  }
</style>
