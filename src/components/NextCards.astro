---
// The end of an inner page: a black band with a heading and two or three
// linked cards pointing somewhere useful next (a program, a form, Donate).
// Each card is one big link. A card with `form` opens that Tally form in a
// popup, like FormButton. Cards may have a photo; the first card's color sits
// on the left, and the middle card drops a little lower (not in Calm).
//
// Usage:
//   <NextCards id="next" heading="Where to next" items={[
//     { title: 'See our programs', text: '…', href: '/programs', color: 'yellow', image: … },
//   ]} />
import Placeholder from './Placeholder.astro';
import Flower from './Flower.astro';
import type { ImageSlot } from '../data/images';
import { site, formUrl, type FormName } from '../data/site';

export interface NextItem {
  title: string;
  text: string;
  label: string; // the "arrow" line at the bottom of the card, e.g. "See our programs"
  color: 'yellow' | 'orange' | 'pink' | 'white';
  href?: string;
  form?: FormName; // opens this form instead of following href
  image?: ImageSlot;
}

interface Props {
  id: string;
  heading: string;
  items: NextItem[];
}

const { id, heading, items } = Astro.props;
// Photos only when every card has one, so the cards stay the same shape.
const showImages = items.every((item) => item.image);
const headingId = `${id}-heading`;
---

<section id={id} class="next-cards" aria-labelledby={headingId}>
  <div class="container">
    <div class="next-cards__head">
      <h2 id={headingId}>{heading}</h2>
      <Flower petals="yellow" center="pink" size="3rem" rotate={14} style="top: -0.75rem; right: -3.5rem" />
    </div>
    <ul class="ncards" role="list" style={`--count: ${items.length}`}>
      {
        items.map((item) => {
          const href = item.form ? formUrl(item.form) : item.href;
          // The band is pink, so a pink card would vanish: it becomes white.
          const color = item.color === 'pink' ? 'white' : item.color;
          return (
            <li class:list={['ncard', `ncard--${color}`]}>
              {showImages && item.image && <Placeholder image={item.image} ratio="16 / 10" class="ncard__photo" />}
              <div class="ncard__body">
                <h3 class="ncard__title">
                  <a href={href} class="ncard__link" data-tally-form={item.form ? site.forms[item.form] : undefined}>
                    {item.title}
                  </a>
                </h3>
                <p>{item.text}</p>
                <span class="ncard__more" aria-hidden="true">
                  {item.label}
                  <svg viewBox="0 0 40 12" width="40" height="12" focusable="false">
                    <path d="M0 6h38M33 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </span>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .next-cards {
    padding-block: var(--section-space);
    background: var(--pink);
    color: var(--ink);
  }

  .next-cards h2 {
    color: var(--on-pink-heading);
  }

  .next-cards__head {
    position: relative;
    width: fit-content;
    margin-inline: auto;
    text-align: center;
  }

  .ncards {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }

  .ncard {
    position: relative;
    display: flex;
    flex-direction: column;
    color: var(--ink);
    --focus-color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: calc(-1 * var(--shadow-offset)) var(--shadow-offset) 0 var(--black);
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .ncard :global(.ncard__photo) {
    border-bottom: 2px solid var(--ink);
  }

  .ncard--yellow { background: var(--yellow); }
  .ncard--orange { background: var(--orange); }
  .ncard--pink { background: var(--pink); }
  .ncard--white { background: var(--white); }

  .ncard__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  .ncard__title {
    font-size: var(--fs-card);
  }

  .ncard--pink .ncard__title {
    color: var(--on-pink-heading);
  }

  /* The whole card is the link; its title is the link text. */
  .ncard__link {
    text-decoration: none;
  }

  .ncard__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .ncard__link:focus-visible {
    outline: none;
  }

  .ncard:has(.ncard__link:focus-visible) {
    outline: var(--focus-width) solid var(--ink);
    outline-offset: var(--focus-offset);
  }

  .ncard__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-3);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur) var(--ease);
  }

  .ncard__more svg {
    flex: none;
    width: 2.5rem;
    height: auto;
    transition: transform var(--dur) var(--ease);
  }

  .ncard:hover,
  .ncard:has(.ncard__link:focus-visible) {
    transform: translate(var(--button-lift), calc(-1 * var(--button-lift))) scale(var(--hover-scale));
    box-shadow: calc(-1 * (var(--shadow-offset) + 4px)) calc(var(--shadow-offset) + 4px) 0 var(--black);
  }

  .ncard:hover .ncard__more {
    text-decoration-color: currentColor;
  }

  .ncard:hover .ncard__more svg {
    transform: translateX(var(--arrow-shift));
  }

  @media (min-width: 56rem) {
    :global(html:not([data-mode='calm'])) .ncards {
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
      align-items: stretch;
    }

    :global(html:not([data-mode='calm'])) .ncard:nth-child(2) {
      translate: 0 calc(var(--stagger) / 2);
    }

    :global(html:not([data-mode='calm'])) .ncards {
      padding-bottom: calc(var(--stagger) / 2);
    }
  }

  @media (max-width: 55.99rem) {
    .next-cards__head :global(.flower) {
      display: none;
    }
  }

  /* Calm: the band is paper, so cards get an ink outline instead of a white shadow. */
  :global(html[data-mode='calm']) .ncard {
    box-shadow: none;
  }

  :global(html[data-mode='calm']) .ncards {
    max-width: 40rem;
  }
</style>
