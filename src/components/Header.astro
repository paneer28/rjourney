---
// Site header on every page: logo on a white block at the left; three joined
// blocks at the right: Donate (pink), Display (orange), Menu (black).
// Menu opens the full-screen site menu (SiteMenu.astro). Without JavaScript it
// is a plain link to /menu, a page listing every page.
// Not sticky. With `overlay`, it sits on top of the page's hero photo.
import DonateButton from './DonateButton.astro';
import DisplayButton from './DisplayButton.astro';
import DisplayHint from './DisplayHint.astro';
import { site } from '../data/site';

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="site-header__bar">
    <a href="/" class="site-header__logo">
      {site.logo ? <img src={site.logo} alt={site.name} height="48" /> : <span class="site-header__wordmark">{site.name}</span>}
    </a>

    <div class="site-header__blocks">
      <DonateButton bare class="site-header__block site-header__donate" />
      <DisplayButton class="site-header__block site-header__display" />

      <button
        type="button"
        id="menu-button"
        class="site-header__block site-header__menu needs-js"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <svg class="site-header__menu-icon" viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" focusable="false">
          <path d="M0 1h20M0 7h20M0 13h20" fill="none" stroke="currentColor" stroke-width="2"></path>
        </svg>
        Menu
      </button>
      <a href="/menu" class="site-header__block site-header__menu no-js-only">
        <svg class="site-header__menu-icon" viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" focusable="false">
          <path d="M0 1h20M0 7h20M0 13h20" fill="none" stroke="currentColor" stroke-width="2"></path>
        </svg>
        Menu
      </a>
    </div>
  </div>

  <DisplayHint />
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
  }

  /* Over the hero photo on wide screens in Standard and Vivid only.
     On narrow screens and in Calm the header sits above the photo instead. */
  @media (min-width: 56rem) {
    :global(html:not([data-mode='calm'])) .site-header--overlay {
      position: absolute;
      inset: 0 0 auto 0;
    }
  }

  .site-header__bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: stretch;
    gap: var(--space-3);
  }

  /* ---------- Logo on a white block ---------- */
  .site-header__logo {
    display: flex;
    align-items: center;
    padding: var(--space-3) var(--space-5);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
  }

  .site-header__logo img {
    width: auto;
    height: 3rem;
  }

  .site-header__wordmark {
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    text-transform: var(--heading-transform);
    font-size: 1.75rem;
    line-height: 1;
  }

  /* ---------- The joined blocks ---------- */
  .site-header__blocks {
    display: flex;
    align-items: stretch;
  }

  .site-header__blocks > :global(.site-header__block) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 0;
    color: var(--ink);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
    cursor: pointer;
    transition: text-decoration-color var(--dur) var(--ease);
  }

  .site-header__blocks > :global(.site-header__block:hover),
  .site-header__blocks > :global(.site-header__block:focus-visible) {
    text-decoration-color: currentColor;
  }

  .site-header__blocks > :global(.site-header__block:focus-visible) {
    outline-offset: calc(-1 * var(--focus-width) - 2px);
  }

  .site-header__blocks > :global(.site-header__donate) {
    background: var(--pink);
  }

  .site-header__blocks > :global(.site-header__display) {
    background: var(--orange);
  }

  .site-header__blocks > .site-header__menu {
    background: var(--black);
    color: var(--on-black);
    --focus-color: var(--on-black);
  }

  .site-header__menu-icon {
    flex: none;
  }

  /* Narrow screens: the same blocks, a little tighter. */
  @media (max-width: 55.99rem) {
    .site-header__blocks > :global(.site-header__block) {
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
    }

    .site-header__logo {
      padding-inline: var(--space-4);
    }

    .site-header__wordmark {
      font-size: 1.5rem;
    }
  }

  /* The narrowest phones: just enough room for all three blocks, even in Calm's larger text. */
  @media (max-width: 22.5rem) {
    .site-header__blocks > :global(.site-header__block) {
      padding-inline: var(--space-3);
    }
  }
</style>
