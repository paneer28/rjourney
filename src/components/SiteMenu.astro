---
// The full-screen site menu, opened by the Menu button in the header.
// Sections and items come from src/data/menu.ts.
//
// Wide screens: section rows on the left; the active section's items fill the
// right column as equal-height tiles. Hovering, focusing, or clicking a row
// makes it active. Up/Down move between rows; Tab goes from a row into its tiles.
// Narrow screens: one column; each row opens its items beneath it (accordion).
//
// Built on <dialog> opened with showModal(), which keeps focus inside, makes the
// page behind inert, closes on Escape, and returns focus to the Menu button.
import { site } from '../data/site';
import { menu, isCurrentPage } from '../data/menu';

const path = Astro.url.pathname;
const currentSection = menu.findIndex((section) => section.items.some((item) => isCurrentPage(item.href, path)));
---

<dialog id="site-menu" class="menu" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="container menu__inner">
    <div class="menu__top">
      <a href="/" class="menu__logo">{site.name}</a>
      <button type="button" class="menu__close">
        <span class="menu__close-label">Close</span>
        <svg class="menu__close-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M1 1l18 18M19 1L1 19" fill="none" stroke="currentColor" stroke-width="2"></path>
        </svg>
      </button>
    </div>

    <div class="menu__body">
      <div class="menu__left">
        <ul class="menu__sections" role="list">
          {
            menu.map((section, s) => (
              <li class="menu__section" data-current={s === currentSection ? 'true' : undefined}>
                <button
                  type="button"
                  id={`menu-row-${section.id}`}
                  class="menu__row"
                  aria-expanded="false"
                  aria-controls={`menu-items-${section.id}`}
                >
                  <span>{section.label}</span>
                  <svg class="menu__arrow" viewBox="0 0 26 18" width="26" height="18" aria-hidden="true" focusable="false">
                    <path d="M0 9h24M16 1l8 8-8 8" fill="none" stroke="currentColor" stroke-width="2.25" />
                  </svg>
                </button>
                <ul id={`menu-items-${section.id}`} class="menu__items" role="list" aria-labelledby={`menu-row-${section.id}`}>
                  {section.items.map((item, i) => (
                    <li class="menu__item" style={`--i: ${i}`}>
                      <a
                        class="menu__tile"
                        href={item.href}
                        aria-current={isCurrentPage(item.href, path) ? 'page' : undefined}
                        target={item.external ? '_blank' : undefined}
                        rel={item.external ? 'noopener' : undefined}
                      >
                        {item.label}
                        {item.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { durationMs } from '../scripts/tokens';

  const dialog = document.getElementById('site-menu') as HTMLDialogElement | null;
  const openButton = document.getElementById('menu-button');

  if (dialog && openButton) {
    const html = document.documentElement;
    const sections = [...dialog.querySelectorAll<HTMLElement>('.menu__section')];
    const rows = sections.map((section) => section.querySelector<HTMLButtonElement>('.menu__row')!);
    const wide = matchMedia('(min-width: 56rem)');
    const currentIndex = sections.findIndex((section) => section.dataset.current === 'true');
    let active: number | null = null;
    let closeTimer = 0;

    // Make one section active (or none, on narrow screens).
    function setActive(index: number | null) {
      active = index;
      sections.forEach((section, i) => {
        section.classList.toggle('is-active', i === index);
        rows[i].setAttribute('aria-expanded', String(i === index));
      });
    }

    function open() {
      clearTimeout(closeTimer);
      dialog!.classList.remove('is-closing');
      // The current page's section, or the first one on wide screens.
      setActive(currentIndex >= 0 ? currentIndex : wide.matches ? 0 : null);
      dialog!.showModal();
      html.classList.add('menu-open'); // stops the page behind from scrolling
      openButton!.setAttribute('aria-expanded', 'true');
      rows[active ?? 0].focus();
    }

    function close() {
      if (!dialog!.open || dialog!.classList.contains('is-closing')) return;
      const fade = durationMs('--menu-fade');
      if (fade > 0) {
        dialog!.classList.add('is-closing');
        closeTimer = window.setTimeout(() => dialog!.close(), fade);
      } else {
        dialog!.close();
      }
    }

    dialog.addEventListener('close', () => {
      dialog.classList.remove('is-closing');
      html.classList.remove('menu-open');
      openButton.setAttribute('aria-expanded', 'false');
      openButton.focus();
    });

    // Escape: fade out like the Close button instead of closing abruptly.
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    // Keep Tab inside the menu: past the last item it wraps to the first, and
    // Shift+Tab from the first wraps to the last. (A modal dialog alone would
    // let focus leave for the browser's address bar.)
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const focusable = [...dialog.querySelectorAll<HTMLElement>('a[href], button')].filter(
        (el) => el.getClientRects().length > 0,
      );
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    openButton.addEventListener('click', open);
    dialog.querySelector('.menu__close')?.addEventListener('click', close);

    rows.forEach((row, i) => {
      // Wide: clicking a row makes it active. Narrow: it opens or closes in place.
      row.addEventListener('click', () => {
        if (wide.matches) setActive(i);
        else setActive(active === i ? null : i);
      });

      // Wide: hovering or focusing a row also makes it active.
      row.addEventListener('mouseenter', () => {
        if (wide.matches && active !== i) setActive(i);
      });
      row.addEventListener('focus', () => {
        if (wide.matches && active !== i) setActive(i);
      });

      // Wide: Up and Down move between rows.
      row.addEventListener('keydown', (event) => {
        if (!wide.matches || (event.key !== 'ArrowDown' && event.key !== 'ArrowUp')) return;
        event.preventDefault();
        const next = (i + (event.key === 'ArrowDown' ? 1 : -1) + rows.length) % rows.length;
        rows[next].focus();
      });
    });

    // Following a link that stays on this page (e.g. #give) closes the menu.
    dialog.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      link.addEventListener('click', () => {
        const url = new URL(link.href, location.href);
        if (url.pathname === location.pathname && !link.target) dialog.close();
      });
    });

    // Widening the window with no section open: open the first one.
    wide.addEventListener('change', () => {
      if (wide.matches && dialog.open && active === null) setActive(currentIndex >= 0 ? currentIndex : 0);
    });
  }
</script>

<style>
  /* Sizes follow the reference design: compact rows, smaller type, Close set
     in from the top right, and item tiles running down to the bottom of the screen. */

  /* ---------- The overlay ---------- */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
    background: var(--menu-bg);
    color: var(--menu-fg);
    --focus-color: var(--menu-fg);
  }

  .menu::backdrop {
    background: var(--menu-bg);
  }

  .menu[open] {
    animation: menu-fade-in var(--menu-fade) ease both;
  }

  .menu.is-closing {
    animation: menu-fade-out var(--menu-fade) ease both;
  }

  @keyframes menu-fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes menu-fade-out {
    to {
      opacity: 0;
    }
  }

  /* The page behind doesn't scroll while the menu is open. */
  :global(html.menu-open) {
    overflow: hidden;
  }

  /* Fills the screen: top row, then the body taking the remaining height. */
  .menu__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-top: var(--space-5);
    padding-bottom: var(--space-7);
  }

  /* ---------- Top row: logo and Close ---------- */
  .menu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-7);
  }

  .menu__logo {
    color: var(--menu-fg);
    text-decoration: none;
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    text-transform: var(--heading-transform);
    font-size: 1.75rem;
    line-height: 1;
  }

  .menu__close {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--menu-active-bg);
    color: var(--menu-active-fg);
    border: 0;
    font-size: var(--fs-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    --focus-color: var(--menu-fg);
  }

  .menu__close-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* ---------- Section rows ---------- */
  .menu__sections {
    padding: 0;
    list-style: none;
  }

  .menu__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-5);
    width: 100%;
    min-height: 4rem;
    padding: var(--space-3) var(--space-4);
    background: var(--row-bg);
    color: var(--menu-fg);
    border: 2px solid var(--menu-outline);
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    text-transform: var(--heading-transform);
    font-size: 1.5rem;
    line-height: 1.1;
    text-align: left;
    cursor: pointer;
  }

  .menu__section:nth-child(odd) {
    --row-bg: var(--menu-row-a);
  }

  .menu__section:nth-child(even) {
    --row-bg: var(--menu-row-b);
  }

  .menu__section + .menu__section .menu__row {
    margin-top: -2px; /* Calm's outlines overlap instead of doubling */
  }

  .menu__section.is-active .menu__row {
    background: var(--menu-active-bg);
    color: var(--menu-active-fg);
    --focus-color: var(--menu-active-fg);
  }

  .menu__row:focus-visible {
    outline-offset: calc(-1 * var(--focus-width) - 4px);
  }

  .menu__arrow {
    flex: none;
    width: 1.625rem;
    height: auto;
  }

  /* ---------- Items ---------- */
  .menu__items {
    display: none;
    padding: 0;
    list-style: none;
  }

  .menu__section.is-active .menu__items {
    display: grid;
  }

  .menu__item {
    display: flex;
    animation: menu-tile-in var(--menu-tiles-fade) ease both;
    animation-delay: calc(var(--i) * var(--menu-tile-stagger));
  }

  @keyframes menu-tile-in {
    from {
      opacity: 0;
    }
  }

  .menu__tile {
    display: flex;
    align-items: center;
    width: 100%;
    color: var(--menu-fg);
    border: 2px solid var(--menu-outline);
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    text-transform: var(--heading-transform);
    line-height: 1.1;
    text-decoration: none;
  }

  .menu__tile:hover,
  .menu__tile:focus-visible {
    background: var(--menu-active-bg);
    color: var(--menu-active-fg);
    --focus-color: var(--menu-active-fg);
  }

  .menu__tile:focus-visible {
    outline-offset: calc(-1 * var(--focus-width) - 4px);
  }

  /* The page you're on: a yellow underline (dark on a yellow tile). */
  .menu__tile[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--menu-active-bg);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  .menu__tile[aria-current='page']:hover,
  .menu__tile[aria-current='page']:focus-visible {
    text-decoration-color: currentColor;
  }

  /* ---------- Wide screens: two columns ---------- */
  @media (min-width: 56rem) {
    .menu__body {
      position: relative;
      flex: 1;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-5);
      min-height: 22rem;
    }

    /* The active section's items fill the right column, down to the bottom. */
    .menu__section.is-active .menu__items {
      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;
      width: calc(50% - var(--space-5) / 2);
      grid-auto-rows: minmax(0, 1fr);
    }

    .menu__item:nth-child(odd) .menu__tile {
      background: var(--menu-tile-a);
    }

    .menu__item:nth-child(even) .menu__tile {
      background: var(--menu-tile-b);
    }

    .menu__item + .menu__item .menu__tile {
      margin-top: -2px;
    }

    .menu__tile {
      justify-content: center;
      padding: var(--space-4);
      text-align: center;
      font-size: 1.75rem;
    }

    .menu__item .menu__tile:hover,
    .menu__item .menu__tile:focus-visible {
      background: var(--menu-active-bg);
    }
  }

  /* ---------- Narrow screens: one column, accordion ---------- */
  @media (max-width: 55.99rem) {
    .menu__inner {
      padding-top: var(--space-4);
    }

    .menu__top {
      margin-bottom: var(--space-5);
    }

    .menu__close {
      padding: var(--space-3);
    }

    .menu__close-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .menu__row {
      min-height: 3.5rem;
      font-size: 1.375rem;
    }

    /* The arrow points down, and up when the section is open. */
    .menu__arrow {
      width: 1.375rem;
      transform: rotate(90deg);
    }

    .menu__section.is-active .menu__arrow {
      transform: rotate(-90deg);
    }

    .menu__tile {
      padding: var(--space-3) var(--space-4);
      background: var(--menu-item-bg);
      border-top: 1px solid var(--menu-divider);
      font-size: 1.25rem;
    }
  }
</style>
